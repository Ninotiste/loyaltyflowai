# ─── Supabase ─────────────────────────────────────────────────────────────────
# Projet Supabase (eu-central-1 Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# NE JAMAIS EXPOSER côté client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Base de données (Prisma) ──────────────────────────────────────────────────
# DATABASE_URL : connexion poolée via PgBouncer (requêtes applicatives)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL : connexion directe sans pooling (prisma migrate uniquement)
DIRECT_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ─── Upstash Redis ────────────────────────────────────────────────────────────
# Instance EU (eu-west-1 Ireland)
UPSTASH_REDIS_REST_URL=https://xxxxxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxx

# ─── Anthropic Claude ─────────────────────────────────────────────────────────
# NE JAMAIS EXPOSER côté client — doit commencer par sk-ant-
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxx

# ─── Resend (emails transactionnels) ──────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx

# ─── Sécurité des Cron Jobs ───────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32 (minimum 32 caractères)
CRON_SECRET=votre-secret-aleatoire-minimum-32-caracteres-ici

# ─── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
